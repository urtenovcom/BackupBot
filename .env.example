# Telegram Bot Token from @BotFather (e.g. 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789

# Telegram Chat ID or Channel ID where backups should be sent (e.g. -1001234567890)
TELEGRAM_CHAT_ID=-1001234567890

# Public age recipient key for encryption (starts with age1...)
# Generate with: age-keygen -o backup_key.txt
AGE_PUBLIC_KEY=age1ql3z7hjy54pw3hyww5ayyfg7zqgvc7w3j2elw8zmrj2kg5sfn9aqmcac8p

# Database passwords (referenced in config.yaml)
MY_WEBSITE_DB_PASSWORD=secret_postgres_pass
CRM_DB_PASSWORD=secret_mariadb_pass

# Optional custom config path
# BACKUPBOT_CONFIG=/etc/backupbot/config.yaml
